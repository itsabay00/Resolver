# --- AI provider: set ONE of these — checked in this order if more than one is present.
# Anthropic key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# OpenAI key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# NVIDIA Build key (free tier available): https://build.nvidia.com
NVIDIA_API_KEY=

# --- Email sending is optional. By default, "Send to customer" opens the
# advisor's own email app (mailto:) — free, no setup. Only add this if you
# want it to send directly from the platform instead: https://resend.com
RESEND_API_KEY=
EMAIL_FROM=
