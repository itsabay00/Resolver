# --- AI provider: set ONE of these — Anthropic is used first if both are present.
# Anthropic key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# OpenAI key (fallback if no Anthropic key is set): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Email sending (for "Send to customer"): https://resend.com
RESEND_API_KEY=
# Optional — defaults to onboarding@resend.dev (Resend's shared test address,
# which can only send to the email you signed up with, until you verify your
# own domain at resend.com/domains).
EMAIL_FROM=
